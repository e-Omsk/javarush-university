# Артефакты локальной сборки – они нам в контейнере не нужны, Maven всё пересоберёт.
target/
*.iml

# Каталоги IDE / системные мусорки.
.idea/
.vscode/
.DS_Store

# Документация лекции к билдy не относится – пусть не утяжеляет build context.
docs/

# Логи, дампы.
*.log
hs_err_pid*

# Git-метаданные внутри образа не нужны.
.git/
.gitignore
